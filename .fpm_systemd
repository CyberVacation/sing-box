-s dir
--name rostra
--category net
--license GPL-3.0-or-later
--description "The universal proxy platform."
--url "https://github.com/CyberVacation/rostra"
--vendor CyberVacation
--maintainer "CyberVacation"
--deb-field "Bug: https://github.com/CyberVacation/rostra/issues"
--no-deb-generate-changes
--config-files /etc/rostra/config.json
--after-install release/config/rostra.postinst

release/config/config.json=/etc/rostra/config.json

release/config/rostra.service=/usr/lib/systemd/system/rostra.service
release/config/rostra@.service=/usr/lib/systemd/system/rostra@.service
release/config/rostra.sysusers=/usr/lib/sysusers.d/rostra.conf
release/config/rostra.rules=usr/share/polkit-1/rules.d/rostra.rules
release/config/rostra-split-dns.xml=/usr/share/dbus-1/system.d/rostra-split-dns.conf

release/completions/rostra.bash=/usr/share/bash-completion/completions/rostra.bash
release/completions/rostra.fish=/usr/share/fish/vendor_completions.d/rostra.fish
release/completions/rostra.zsh=/usr/share/zsh/site-functions/_rostra

LICENSE=/usr/share/licenses/rostra/LICENSE
